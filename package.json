{
  "name": "ndi-registration",
  "version": "2.0.0",
  "description": "Team registration system for Nuit de l'Info - Astro + Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "bun run build && vitest run && vitest run -c vitest.dom.config.js",
    "test:dom": "vitest run -c vitest.dom.config.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "astro",
    "cloudflare",
    "workers",
    "d1",
    "registration"
  ],
  "author": "Guillaume Coquard",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "astro": "^7.3.3",
    "@astrojs/cloudflare": "^14.3.2",
    "astro-core": "workspace:*",
    "@info-evry/astro-design": "workspace:*",
    "@info-evry/knowledge": "workspace:*",
    "astro-payments": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
