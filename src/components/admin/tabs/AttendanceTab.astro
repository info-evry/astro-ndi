---
/**
 * AttendanceTab - Check-in/out management for participants
 */
---

<div id="panel-attendance" class="tab-panel hidden" role="tabpanel" aria-labelledby="tab-attendance">
  <!-- Attendance Stats -->
  <div class="disclosure-group open" data-disclosure="attendance-stats">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Statistiques de présence</h2>
      <div class="header-actions" data-action="stop-propagation" data-stop>
        <button type="button" id="refresh-attendance-btn" class="btn btn-secondary btn-sm">Rafraîchir</button>
      </div>
    </div>
    <div class="disclosure-body">
      <div id="attendance-stats-grid" class="stats-grid"></div>
    </div>
  </div>

  <!-- Attendance List -->
  <div class="disclosure-group open" data-disclosure="attendance-list">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Liste des participants</h2>
      <div class="header-actions" data-action="stop-propagation" data-stop>
        <div class="search-input-wrapper">
          <span class="search-icon sf-symbol" aria-hidden="true">@sfs:magnifyingglass@</span>
          <input type="search" id="attendance-search" class="search-input" placeholder="Rechercher un participant...">
        </div>
      </div>
    </div>
    <div class="disclosure-body">
      <div class="filter-bar">
        <label class="filter-pill" id="filter-all-pill">
          <input type="radio" name="attendance-filter" value="all" checked> 􀋲 Tous
        </label>
        <label class="filter-pill" id="filter-present-pill">
          <input type="radio" name="attendance-filter" value="present"> 􀁣 Présents
        </label>
        <label class="filter-pill" id="filter-absent-pill">
          <input type="radio" name="attendance-filter" value="absent"> 􀁡 Absents
        </label>
      </div>
      <div class="table-container">
        <table id="attendance-table" class="members-table attendance-table">
          <thead>
            <tr>
              <th class="sortable" data-sort-key="name">Nom <span class="sort-indicator"></span></th>
              <th class="sortable" data-sort-key="email">Email <span class="sort-indicator"></span></th>
              <th class="sortable team-col" data-sort-key="team">Équipe <span class="sort-indicator"></span></th>
              <th class="sortable status-col" data-sort-key="status">Statut <span class="sort-indicator"></span></th>
              <th class="sortable time-col" data-sort-key="time">Heure <span class="sort-indicator"></span></th>
              <th class="sortable" data-sort-key="payment">Paiement <span class="sort-indicator"></span></th>
              <th class="actions-col">Actions</th>
            </tr>
          </thead>
          <tbody id="attendance-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div><!-- End Attendance Panel -->
