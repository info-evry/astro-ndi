---
/**
 * SettingsTab - Settings management panel
 * Initial values come from src/shared/constants.js (the same defaults the API uses).
 */
import {
  DEFAULT_GDPR_RETENTION_YEARS,
  DEFAULT_LATE_CUTOFF_TIME,
  DEFAULT_MAX_TEAM_SIZE,
  DEFAULT_MAX_TOTAL_PARTICIPANTS,
  DEFAULT_MIN_TEAM_SIZE,
  DEFAULT_PRICES,
  DEFAULT_SCHOOL_NAME
} from '../../../shared/constants.js';

const euros = (cents: number) => (cents / 100).toFixed(2);
---

<div id="panel-settings" class="tab-panel hidden" role="tabpanel" aria-labelledby="tab-settings">
  <div class="settings-header">
    <h2>Paramètres</h2>
    <div class="settings-header-actions">
      <span id="settings-dirty-hint" class="form-hint hidden" role="status">Modifications non enregistrées</span>
      <button type="button" id="save-settings-btn" class="btn btn-primary" disabled>
        Enregistrer
      </button>
    </div>
  </div>

  <!-- General Settings -->
  <div class="disclosure-group open" data-disclosure="settings-general">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Général</h2>
    </div>
    <div class="disclosure-body">
      <div class="settings-card">
        <h3>Export Officiel NDI</h3>
        <div class="form-group">
          <label for="setting-school-name">Nom de l'école (exact comme saisi sur le site NDI)</label>
          <input type="text" id="setting-school-name" value={DEFAULT_SCHOOL_NAME} maxlength="256" placeholder={DEFAULT_SCHOOL_NAME}>
        </div>
      </div>

      <div class="settings-card">
        <h3>Limites de capacité</h3>
        <div class="settings-grid">
          <div class="form-group">
            <label for="setting-max-team">Taille max d'équipe</label>
            <input type="number" id="setting-max-team" min="1" max="100" value={DEFAULT_MAX_TEAM_SIZE}>
          </div>
          <div class="form-group">
            <label for="setting-max-participants">Participants max</label>
            <input type="number" id="setting-max-participants" min="1" max="10000" value={DEFAULT_MAX_TOTAL_PARTICIPANTS}>
          </div>
          <div class="form-group">
            <label for="setting-min-team">Taille min d'équipe</label>
            <input type="number" id="setting-min-team" min="1" max="50" value={DEFAULT_MIN_TEAM_SIZE}>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pizza Management -->
  <div class="disclosure-group open" data-disclosure="settings-pizzas">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Pizzas</h2>
    </div>
    <div class="disclosure-body">
      <div class="settings-card">
        <h3>Gestion des pizzas</h3>
        <p class="settings-description">
          Chaque ajout, modification ou suppression est enregistré immédiatement
          (sans passer par « Enregistrer »). La pizza « Aucune » (pas de pizza) ne peut pas être supprimée.
        </p>
        <div id="pizzas-list" class="pizzas-list"></div>

        <div id="pizza-add-form" class="pizza-add-form">
          <h4>Ajouter une pizza</h4>
          <form id="add-pizza-form-element">
            <div class="settings-grid">
              <div class="form-group">
                <label for="new-pizza-id">ID (unique)</label>
                <input type="text" id="new-pizza-id" placeholder="ex: hawaienne" required>
              </div>
              <div class="form-group">
                <label for="new-pizza-name">Nom</label>
                <input type="text" id="new-pizza-name" placeholder="ex: Hawaïenne" required>
              </div>
              <div class="form-group">
                <label for="new-pizza-desc">Description</label>
                <input type="text" id="new-pizza-desc" placeholder="ex: Tomate, jambon, ananas">
              </div>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm"><span class="sf-symbol">@sfs:plus@</span> Ajouter</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- On-site Pricing Settings -->
  <div class="disclosure-group open" data-disclosure="settings-onsite">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Tarification sur place</h2>
    </div>
    <div class="disclosure-body">
      <div class="settings-card">
        <h3>Tarification à l'entrée</h3>
        <p class="settings-description">Prix de participation pour ceux qui paient sur place.</p>
        <div class="settings-grid">
          <div class="form-group">
            <label for="setting-price-asso-member">Prix membre asso (€)</label>
            <input type="number" id="setting-price-asso-member" min="0" max="100" step="0.01" value={euros(DEFAULT_PRICES.assoMember)}>
          </div>
          <div class="form-group">
            <label for="setting-price-non-member">Prix non-membre (€)</label>
            <input type="number" id="setting-price-non-member" min="0" max="100" step="0.01" value={euros(DEFAULT_PRICES.nonMember)}>
          </div>
          <div class="form-group">
            <label for="setting-late-cutoff">Heure limite (arrivée tardive)</label>
            <input type="time" id="setting-late-cutoff" value={DEFAULT_LATE_CUTOFF_TIME}>
          </div>
          <div class="form-group">
            <label for="setting-price-late">Prix retardataire (€)</label>
            <input type="number" id="setting-price-late" min="0" max="100" step="0.01" value={euros(DEFAULT_PRICES.late)}>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Archive & Data Management -->
  <div class="disclosure-group" data-disclosure="settings-archive">
    <div class="disclosure-header" data-action="toggle-disclosure">
      <h2><span class="disclosure-chevron sf-symbol">@sfs:chevron.right@</span> Archivage & Données</h2>
    </div>
    <div class="disclosure-body">
      <div class="settings-card">
        <h3>Créer une archive</h3>
        <p class="settings-description">
          Archivez les données de l'édition actuelle avant de réinitialiser pour la prochaine année.
          L'archive conserve une copie complète des équipes, participants et statistiques.
        </p>
        <div class="archive-info" id="current-event-info">
          <p>Année de l'événement : <strong id="current-event-year">-</strong></p>
          <p>Équipes : <strong id="current-teams-count">-</strong></p>
          <p>Participants : <strong id="current-participants-count">-</strong></p>
        </div>
        <button type="button" id="create-archive-btn" class="btn btn-primary">
          📁 Créer l'archive
        </button>
      </div>

      <div class="settings-card">
        <h3>Rétention GDPR</h3>
        <p class="settings-description">
          Durée de conservation des données personnelles dans les archives.
          Après expiration, les données sont automatiquement anonymisées (noms, emails supprimés).
        </p>
        <div class="form-group">
          <label for="setting-gdpr-retention">Durée de rétention (années)</label>
          <input type="number" id="setting-gdpr-retention" min="1" max="10" value={DEFAULT_GDPR_RETENTION_YEARS}>
          <span class="form-hint">Les archives plus anciennes seront anonymisées</span>
        </div>
        <button type="button" id="check-expiration-btn" class="btn btn-secondary">
          🔍 Vérifier les expirations
        </button>
        <p id="expiration-result" class="result-text hidden"></p>
      </div>

      <div class="settings-card danger-zone">
        <h3><span class="sf-symbol">@sfs:exclamationmark.triangle@</span> Zone dangereuse</h3>
        <p class="settings-description warning-text">
          Réinitialisez toutes les données pour préparer une nouvelle édition.
          <strong>Cette action est irréversible.</strong>
        </p>
        <div id="reset-safety-check" class="reset-safety-check">
          <p class="checking">Vérification en cours...</p>
        </div>
        <button type="button" id="reset-data-btn" class="btn btn-danger" disabled>
          🗑️ Réinitialiser toutes les données
        </button>
      </div>
    </div>
  </div>
</div><!-- End Settings Panel -->
