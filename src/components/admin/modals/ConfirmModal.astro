---
/**
 * ConfirmModal - Generic confirmation dialog
 */
import Modal from '@info-evry/astro-design/components/admin/Modal.astro';
---

<Modal id="confirm-modal" title="Confirmer la suppression">
  <p id="confirm-message"></p>
  <button type="button" slot="actions" class="btn btn-secondary" data-modal-close="confirm-modal">􀁑 Annuler</button>
  <button type="button" slot="actions" id="confirm-delete-btn" class="btn btn-danger">􀈑 Supprimer</button>
</Modal>
