---
import '@info-evry/astro-design';
import Head from '@info-evry/astro-design/components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '@info-evry/astro-design/components/MobileNav.astro';
import associationInfo from '@info-evry/knowledge/association';
import ndiEvent from '@info-evry/knowledge/ndi/event';
import '../styles/ndi.css';

const mobileNavItems = [
  { href: '#teams', label: 'Équipes', icon: 'person.3' },
];

interface Props {
  title: string;
  description?: string;
  image?: string;
  adminStyles?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  noindex?: boolean;
}

const DEFAULT_IMAGE = "og.jpg";

const {
  title,
  description = `Inscription des équipes pour la ${ndiEvent.name} ${ndiEvent.year} - ${ndiEvent.edition}`,
  image = DEFAULT_IMAGE,
  adminStyles = false,
  showHeader = true,
  showFooter = true,
  noindex = false
} = Astro.props;

// Ensure siteUrl has trailing slash for relative URL resolution
const siteUrl = associationInfo.sites.ndi.url.replace(/\/?$/, '/');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <Head
    title={title}
    description={description}
    image={image}
    noindex={noindex}
    canonicalUrl={canonicalUrl}
    siteName={`${ndiEvent.name} - ${associationInfo.name}`}
    author={associationInfo.fullName}
  />
</head>
<body>
  {showHeader && <Header />}

  <slot />

  {showFooter && <Footer />}

  <MobileNav
    items={mobileNavItems}
    ctaHref="#inscription"
    ctaLabel="S'inscrire"
    ctaIcon="person.badge.plus"
  />
</body>
</html>
