# Local development secrets for `astro dev` (Cloudflare platformProxy).
# Copy this file to `.dev.vars` (gitignored) - `bun run dev` does this
# automatically the first time you run it.

ADMIN_TOKEN=dev-admin-token

# Optional: set these to test email sending / online payments locally.
# RESEND_API_KEY=your-resend-api-key-here
# SUMUP_API_KEY=your-sumup-api-key-here
